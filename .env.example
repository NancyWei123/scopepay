# Server-side values only. Never commit your real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# At least 32 unpredictable characters. Example generator in README.
QUOTE_SIGNING_SECRET=
PORT=3000
HOST=127.0.0.1
# For a hosted Node deployment behind a proxy, set the exact public HTTPS origin.
# PUBLIC_ORIGIN=https://your-app.example
